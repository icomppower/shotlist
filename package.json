    "comfy:smoke": "node scripts/comfy-smoke.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "ffmpeg-static": "^5.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001815"
  }
}
