{
  "name": "shotlist",
  "version": "0.1.0",
  "private": true,
  "description": "Turns one image, or one sentence, into a short cinematic trailer with LTX 2.5 on Comfy Cloud.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
