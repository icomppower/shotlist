# Comfy Cloud API key for local RUNNER=comfy and npm run demo:clips — from
# platform.comfy.org. Never set this on the public Vercel deploy.
COMFY_API_KEY=

# Which job runner renders shots: mock | comfy | demo
# (Vercel defaults to demo: pre-made clips + visitors' own keys)
RUNNER=mock

# Where projects and clips are stored: local | blob
STORAGE=local

# Vercel Blob read-write token (only needed when STORAGE=blob)
BLOB_READ_WRITE_TOKEN=

# Renders allowed per UTC day across everyone (protects a public link)
DAILY_SHOT_CAP=60
