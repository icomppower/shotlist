# Comfy Cloud API key (only needed when RUNNER=comfy) — from platform.comfy.org
COMFY_API_KEY=

# Which job runner renders shots: mock | comfy
RUNNER=mock

# Where projects and clips are stored: local | blob
STORAGE=local

# Vercel Blob read-write token (only needed when STORAGE=blob)
BLOB_READ_WRITE_TOKEN=

# Renders allowed per UTC day across everyone (protects a public link)
DAILY_SHOT_CAP=60
